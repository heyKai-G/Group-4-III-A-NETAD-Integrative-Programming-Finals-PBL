# Copy of the settings setup.ps1 writes into .env (you normally never edit this by hand)
SECRET_KEY=change-me
DATABASE_URL=postgresql+pg8000://lab_ids:PASSWORD@localhost:5432/lab_ids
EVE_JSON_PATH=C:\Program Files\Suricata\log\eve.json
SURICATA_EXE=C:\Program Files\Suricata\suricata.exe
SURICATA_YAML=C:\Program Files\Suricata\suricata.yaml
BIND_HOST=0.0.0.0
HTTPS_PORT=5443
SESSION_MINUTES=15
RETENTION_DAYS=90
APP_TZ=Asia/Manila

# Optional: "email me a reset link" on the Forgot-password page. Leave empty to keep it off.
# Needs internet on the IDS laptop (the lab bridge has none unless the PLDT router gives it).
# PUBLIC_URL is the address the link will point to, e.g. https://192.168.1.10:5443
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
RESET_LINK_MINUTES=30
