# Lab IDS local rules - generated by the web app. Do not edit by hand;
# change the settings in the web app instead (they overwrite this file).
# Sensitivity: medium

# ---- Brute force: bursts of new connections to login services ----
alert tcp any any -> $HOME_NET 22 (msg:"LAB-IDS [Brute Force] SSH connection burst from one source"; flags:S,12; threshold:type both, track by_src, count 8, seconds 60; classtype:attempted-admin; sid:9000001; rev:1;)
alert tcp any any -> $HOME_NET 21 (msg:"LAB-IDS [Brute Force] FTP connection burst from one source"; flags:S,12; threshold:type both, track by_src, count 8, seconds 60; classtype:attempted-admin; sid:9000002; rev:1;)
alert tcp any any -> $HOME_NET 23 (msg:"LAB-IDS [Brute Force] Telnet connection burst from one source"; flags:S,12; threshold:type both, track by_src, count 8, seconds 60; classtype:attempted-admin; sid:9000003; rev:1;)
alert tcp any any -> $HOME_NET 3389 (msg:"LAB-IDS [Brute Force] RDP connection burst from one source"; flags:S,12; threshold:type both, track by_src, count 8, seconds 60; classtype:attempted-admin; sid:9000004; rev:1;)

# ---- Brute force: failed-login replies from the server ----
alert tcp $HOME_NET 21 -> any any (msg:"LAB-IDS [Brute Force] FTP repeated failed logins"; flow:established,to_client; content:"530 "; depth:4; threshold:type both, track by_dst, count 5, seconds 60; classtype:attempted-admin; sid:9000010; rev:1;)
alert tcp $HOME_NET 23 -> any any (msg:"LAB-IDS [Brute Force] Telnet repeated failed logins"; flow:established,to_client; content:"Login incorrect"; nocase; threshold:type both, track by_dst, count 5, seconds 60; classtype:attempted-admin; sid:9000011; rev:1;)
alert http $HOME_NET any -> any any (msg:"LAB-IDS [Brute Force] HTTP repeated 401 Unauthorized replies"; flow:established,to_client; http.stat_code; content:"401"; threshold:type both, track by_dst, count 5, seconds 60; classtype:attempted-admin; sid:9000012; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB-IDS [Brute Force] HTTP repeated login form submissions"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"login"; nocase; threshold:type both, track by_src, count 8, seconds 60; classtype:attempted-admin; sid:9000014; rev:1;)

# ---- Scans using unusual TCP flags ----
alert tcp any any -> $HOME_NET any (msg:"LAB-IDS [Port Scan] TCP Xmas scan (FIN+PSH+URG)"; flags:FPU,12; threshold:type both, track by_src, count 4, seconds 10; classtype:attempted-recon; sid:9000020; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB-IDS [Port Scan] TCP NULL scan (no flags)"; flags:0; threshold:type both, track by_src, count 4, seconds 10; classtype:attempted-recon; sid:9000021; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB-IDS [Port Scan] TCP FIN scan"; flags:F,12; threshold:type both, track by_src, count 4, seconds 10; classtype:attempted-recon; sid:9000022; rev:1;)

# ---- Floods (counted per victim, so distributed floods are caught too) ----
alert tcp any any -> $HOME_NET any (msg:"LAB-IDS [DDoS] SYN flood"; flags:S,12; threshold:type both, track by_dst, count 1500, seconds 5; classtype:attempted-dos; sid:9000030; rev:1;)
alert udp any any -> $HOME_NET any (msg:"LAB-IDS [DDoS] UDP flood"; threshold:type both, track by_dst, count 1500, seconds 5; classtype:attempted-dos; sid:9000031; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"LAB-IDS [DDoS] ICMP echo flood"; itype:8; threshold:type both, track by_dst, count 500, seconds 5; classtype:attempted-dos; sid:9000032; rev:1;)

# ---- Malware indicators ----
# Matches only part of the standard EICAR antivirus test string, so antivirus
# software does not quarantine this rules file.
alert http any any -> any any (msg:"LAB-IDS [Malware/C2] EICAR antivirus test file transferred"; flow:established,to_client; file_data; content:"EICAR-STANDARD-ANTIVIRUS-TEST-FILE"; classtype:trojan-activity; sid:9000040; rev:1;)
alert tcp $HOME_NET any -> any [4444,31337,1337,6667,6697] (msg:"LAB-IDS [Malware/C2] Outbound connection to a common reverse-shell / IRC botnet port"; flags:S,12; threshold:type limit, track by_src, count 1, seconds 60; classtype:trojan-activity; sid:9000041; rev:1;)
